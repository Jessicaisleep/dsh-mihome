{
  "name": "@jessicaisleep/dsh-mihome",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: control Mi Home (米家) devices — list devices, read/write properties, run actions and scenes, read sensors — through mijiaAPI over a local JSON-Lines bridge, with a sidebar workbench. · 通过 mijiaAPI 本地桥接控制米家设备：设备列表、属性读写、场景执行、传感器读数，并在侧栏提供工作台面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "python/**/*.py",
    "python/**/*.png",
    "python/**/*.ico",
    "python/LICENSE",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "LICENSE",
    "README.md"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Jessicaisleep",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jessicaisleep/dsh-mihome.git"
  },
  "bugs": {
    "url": "https://github.com/Jessicaisleep/dsh-mihome/issues"
  },
  "homepage": "https://github.com/Jessicaisleep/dsh-mihome#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "mihome",
    "mijia",
    "xiaomi",
    "smart-home",
    "cordis"
  ],
  "scripts": {
    "test": "node --test"
  }
}
