{
  "name": "@jessicaisleep/dsh-mihome",
  "version": "2.0.0",
  "description": "DSH 全屋智能工作台：局域网与蓝牙发现、米家云端、Home Assistant 实体控制、已支持的本地协议、私有连接配置与自定义场景。控制项按设备实际能力提供；管理页读取和仅识别协议见支持矩阵。 · DSH smart-home workbench with LAN/BLE discovery, Mi Home cloud, Home Assistant entities, supported local protocols, private connection settings and custom scenes. Controls follow reported device capabilities; see the support matrix for read-only and discovery-only protocols.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "python/**/*.py",
    "python/**/*.png",
    "python/**/*.ico",
    "python/LICENSE",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "requirements.txt",
    "requirements-optional.txt",
    "scripts/update-oui.py",
    "docs/*.md"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Jessicaisleep",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jessicaisleep/dsh-mihome.git"
  },
  "bugs": {
    "url": "https://github.com/Jessicaisleep/dsh-mihome/issues"
  },
  "homepage": "https://github.com/Jessicaisleep/dsh-mihome#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "mihome",
    "mijia",
    "xiaomi",
    "smart-home",
    "tuya",
    "shelly",
    "router",
    "home-automation",
    "cordis"
  ],
  "scripts": {
    "test": "node --test"
  }
}
